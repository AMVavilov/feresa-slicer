solid parity_speed_box
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 160 160 0
      vertex 160 0 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 0 160 0
      vertex 160 160 0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 0.8
      vertex 160 0 0.8
      vertex 160 160 0.8
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 0.8
      vertex 160 160 0.8
      vertex 0 160 0.8
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 160 0 0
      vertex 160 0 0.8
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 160 0 0.8
      vertex 0 0 0.8
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 160 0 0
      vertex 160 160 0
      vertex 160 160 0.8
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 160 0 0
      vertex 160 160 0.8
      vertex 160 0 0.8
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 160 160 0
      vertex 0 160 0
      vertex 0 160 0.8
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 160 160 0
      vertex 0 160 0.8
      vertex 160 160 0.8
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 160 0
      vertex 0 0 0
      vertex 0 0 0.8
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 160 0
      vertex 0 0 0.8
      vertex 0 160 0.8
    endloop
  endfacet
endsolid parity_speed_box
